rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsNewDoc() {
      return signedIn() && request.resource.data.uid == request.auth.uid;
    }

    function ownsExistingDoc() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    function keepsOwner() {
      return ownsExistingDoc() && request.resource.data.uid == resource.data.uid;
    }

    function optionalString(data, field) {
      return !(field in data) || data[field] is string || data[field] == null;
    }

    function optionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    function optionalNumberText(data, field) {
      return !(field in data) || data[field] is string || data[field] == null;
    }

    function optionalImage(data) {
      return !("image" in data) || data.image == null || (data.image is string && data.image.size() < 750000);
    }

    function validRating(data) {
      return !(("rating" in data)) || (data.rating is int && data.rating >= 0 && data.rating <= 5);
    }

    function validImpression(data) {
      return !(("impression" in data)) || data.impression == null ||
        data.impression == "enjoyed" || data.impression == "meh" || data.impression == "not-for-me";
    }

    function validTags(data) {
      return !(("tags" in data)) || (data.tags is list && data.tags.size() <= 20);
    }

    function optionalNumber(data, field) {
      return !(field in data) || data[field] is int || data[field] is float || data[field] == null;
    }

    function validElizabethProfile(data) {
      return !("elizabeth" in data) || (
        data.elizabeth is map &&
        data.elizabeth.keys().hasOnly([
          "machineVersion", "firmware", "temperatureUnit", "brewTemperature",
          "steamTemperature", "observedPressure", "preinfusionMode"
        ]) &&
        optionalString(data.elizabeth, "machineVersion") &&
        optionalString(data.elizabeth, "firmware") &&
        (!(("temperatureUnit" in data.elizabeth)) || data.elizabeth.temperatureUnit == "F" || data.elizabeth.temperatureUnit == "C") &&
        optionalNumber(data.elizabeth, "brewTemperature") &&
        optionalNumber(data.elizabeth, "steamTemperature") &&
        (!("observedPressure" in data.elizabeth) || data.elizabeth.observedPressure is int || data.elizabeth.observedPressure is float || data.elizabeth.observedPressure == "") &&
        optionalString(data.elizabeth, "preinfusionMode")
      );
    }

    function validBiancaProfile(data) {
      return !("bianca" in data) || (
        data.bianca is map &&
        data.bianca.keys().hasOnly([
          "machineVersion", "firmware", "temperatureUnit", "brewTemperature",
          "steamTemperature", "observedPressure", "brewOffset", "preinfusionOn",
          "preinfusionOff", "lowFlowStart", "lowFlowFinal"
        ]) &&
        optionalString(data.bianca, "machineVersion") &&
        optionalString(data.bianca, "firmware") &&
        (!("temperatureUnit" in data.bianca) || data.bianca.temperatureUnit == "F" || data.bianca.temperatureUnit == "C") &&
        optionalNumber(data.bianca, "brewTemperature") &&
        optionalNumber(data.bianca, "steamTemperature") &&
        (!("observedPressure" in data.bianca) || data.bianca.observedPressure is int || data.bianca.observedPressure is float || data.bianca.observedPressure == "") &&
        optionalNumber(data.bianca, "brewOffset") &&
        optionalNumber(data.bianca, "preinfusionOn") &&
        optionalNumber(data.bianca, "preinfusionOff") &&
        optionalNumber(data.bianca, "lowFlowStart") &&
        optionalNumber(data.bianca, "lowFlowFinal")
      );
    }

    function validProfile(data) {
      return data.keys().hasOnly(["machineId", "machineName", "defaultDose", "finerDirection", "b1", "b2", "elizabeth", "bianca"]) &&
        (!("machineId" in data) || data.machineId == "elizabeth" || data.machineId == "bianca") &&
        optionalString(data, "machineName") &&
        (!("finerDirection" in data) || data.finerDirection == "lower" || data.finerDirection == "higher") &&
        (!("defaultDose" in data) || data.defaultDose is int || data.defaultDose is float) &&
        (!("b1" in data) || data.b1 is map) &&
        (!("b2" in data) || data.b2 is map) &&
        validElizabethProfile(data) &&
        validBiancaProfile(data);
    }

    function validBean(data) {
      return data.keys().hasOnly([
          "uid", "roaster", "roasterLocation", "name", "origin", "roastLevel",
          "tenBeanWeight", "tags", "rating", "impression", "image", "imageUrl", "imagePath", "currentRoastDate",
          "createdAt", "updatedAt", "archived", "archivedAt"
        ]) &&
        data.keys().hasAll(["uid", "name"]) &&
        data.uid is string &&
        data.name is string &&
        data.name.size() > 0 &&
        optionalString(data, "roaster") &&
        optionalString(data, "roasterLocation") &&
        optionalString(data, "origin") &&
        optionalString(data, "roastLevel") &&
        optionalString(data, "currentRoastDate") &&
        optionalNumberText(data, "tenBeanWeight") &&
        optionalImage(data) &&
        optionalString(data, "imageUrl") &&
        optionalString(data, "imagePath") &&
        (!("archived" in data) || data.archived is bool) &&
        validTags(data) &&
        validRating(data) &&
        validImpression(data) &&
        optionalTimestamp(data, "createdAt") &&
        optionalTimestamp(data, "updatedAt") &&
        optionalTimestamp(data, "archivedAt");
    }

    function validBrewLog(data) {
      return data.keys().hasOnly([
          "uid", "beanId", "grind", "time", "dose", "yield", "date", "roastDate",
          "machineId",
          "profileUsed", "taste", "brewTemperature", "pressureObserved",
          "temperatureUnit", "firstDropSeconds", "channelingObserved"
        ]) &&
        data.keys().hasAll(["uid", "beanId", "grind", "date"]) &&
        data.uid is string &&
        data.beanId is string &&
        data.grind is string &&
        data.grind.size() > 0 &&
        (!("machineId" in data) || data.machineId == "elizabeth" || data.machineId == "bianca") &&
        optionalNumberText(data, "time") &&
        optionalNumberText(data, "dose") &&
        optionalNumberText(data, "yield") &&
        (!(("profileUsed" in data)) || data.profileUsed == "" || data.profileUsed == "manual" || data.profileUsed == "p1" || data.profileUsed == "p2" || data.profileUsed == "bianca-standard" || data.profileUsed == "bianca-low-flow" || data.profileUsed == "bianca-paddle" || data.profileUsed == "bianca-bloom") &&
        (!(("taste" in data)) || data.taste == "" || data.taste == "balanced" || data.taste == "sour" || data.taste == "bitter" || data.taste == "astringent" || data.taste == "hollow" || data.taste == "channeling") &&
        optionalNumberText(data, "brewTemperature") &&
        (!(("temperatureUnit" in data)) || data.temperatureUnit == "F" || data.temperatureUnit == "C") &&
        optionalNumberText(data, "pressureObserved") &&
        optionalNumberText(data, "firstDropSeconds") &&
        (!("channelingObserved" in data) || data.channelingObserved is bool) &&
        optionalString(data, "roastDate") &&
        data.date is timestamp;
    }

    function validMaintenanceRecord(data) {
      return data.keys().hasOnly([
          "uid", "machineId", "type", "completedDate", "nextDueDate", "notes", "createdAt"
        ]) &&
        data.keys().hasAll(["uid", "type", "completedDate", "createdAt"]) &&
        data.uid is string &&
        (!("machineId" in data) || data.machineId == "elizabeth" || data.machineId == "bianca") &&
        data.type is string && data.type.size() > 0 && data.type.size() <= 80 &&
        data.completedDate is string && data.completedDate.size() == 10 &&
        optionalString(data, "nextDueDate") &&
        optionalString(data, "notes") &&
        (!("notes" in data) || data.notes == null || data.notes.size() <= 500) &&
        data.createdAt is timestamp;
    }

    match /user_profiles/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId && validProfile(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /beans/{docId} {
      allow read, delete: if ownsExistingDoc();
      allow create: if ownsNewDoc() && validBean(request.resource.data);
      allow update: if keepsOwner() && validBean(request.resource.data);
    }

    match /brew_logs/{docId} {
      allow read, delete: if ownsExistingDoc();
      allow create: if ownsNewDoc() && validBrewLog(request.resource.data);
      allow update: if keepsOwner() && validBrewLog(request.resource.data);
    }

    match /maintenance_records/{docId} {
      allow read, delete: if ownsExistingDoc();
      allow create: if ownsNewDoc() && validMaintenanceRecord(request.resource.data);
      allow update: if keepsOwner() && validMaintenanceRecord(request.resource.data);
    }
  }
}
