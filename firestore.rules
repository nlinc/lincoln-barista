rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsNewDoc() {
      return signedIn() && request.resource.data.uid == request.auth.uid;
    }

    function ownsExistingDoc() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    function keepsOwner() {
      return ownsExistingDoc() && request.resource.data.uid == resource.data.uid;
    }

    function optionalString(data, field) {
      return !(field in data) || data[field] is string || data[field] == null;
    }

    function optionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    function optionalNumberText(data, field) {
      return !(field in data) || data[field] is string || data[field] == null;
    }

    function optionalImage(data) {
      return !("image" in data) || data.image == null || (data.image is string && data.image.size() < 750000);
    }

    function validRating(data) {
      return !(("rating" in data)) || (data.rating is int && data.rating >= 0 && data.rating <= 5);
    }

    function validTags(data) {
      return !(("tags" in data)) || (data.tags is list && data.tags.size() <= 20);
    }

    function validProfile(data) {
      return data.keys().hasOnly(["machineName", "aiEnabled", "defaultDose", "finerDirection", "b1", "b2"]) &&
        optionalString(data, "machineName") &&
        (!("finerDirection" in data) || data.finerDirection == "lower" || data.finerDirection == "higher") &&
        (!("aiEnabled" in data) || data.aiEnabled is bool) &&
        (!("defaultDose" in data) || data.defaultDose is int || data.defaultDose is float) &&
        (!("b1" in data) || data.b1 is map) &&
        (!("b2" in data) || data.b2 is map);
    }

    function validBean(data) {
      return data.keys().hasOnly([
          "uid", "roaster", "roasterLocation", "name", "origin", "roastLevel",
          "tenBeanWeight", "tags", "rating", "image", "imageUrl", "imagePath", "currentRoastDate",
          "createdAt", "updatedAt", "archived", "archivedAt"
        ]) &&
        data.keys().hasAll(["uid", "name"]) &&
        data.uid is string &&
        data.name is string &&
        data.name.size() > 0 &&
        optionalString(data, "roaster") &&
        optionalString(data, "roasterLocation") &&
        optionalString(data, "origin") &&
        optionalString(data, "roastLevel") &&
        optionalString(data, "currentRoastDate") &&
        optionalNumberText(data, "tenBeanWeight") &&
        optionalImage(data) &&
        optionalString(data, "imageUrl") &&
        optionalString(data, "imagePath") &&
        (!("archived" in data) || data.archived is bool) &&
        validTags(data) &&
        validRating(data) &&
        optionalTimestamp(data, "createdAt") &&
        optionalTimestamp(data, "updatedAt") &&
        optionalTimestamp(data, "archivedAt");
    }

    function validBrewLog(data) {
      return data.keys().hasOnly([
          "uid", "beanId", "grind", "time", "dose", "yield", "date", "roastDate"
        ]) &&
        data.keys().hasAll(["uid", "beanId", "grind", "date"]) &&
        data.uid is string &&
        data.beanId is string &&
        data.grind is string &&
        data.grind.size() > 0 &&
        optionalNumberText(data, "time") &&
        optionalNumberText(data, "dose") &&
        optionalNumberText(data, "yield") &&
        optionalString(data, "roastDate") &&
        data.date is timestamp;
    }

    function validMaintenanceRecord(data) {
      return data.keys().hasOnly([
          "uid", "type", "completedDate", "nextDueDate", "notes", "createdAt"
        ]) &&
        data.keys().hasAll(["uid", "type", "completedDate", "createdAt"]) &&
        data.uid is string &&
        data.type is string && data.type.size() > 0 && data.type.size() <= 80 &&
        data.completedDate is string && data.completedDate.size() == 10 &&
        optionalString(data, "nextDueDate") &&
        optionalString(data, "notes") &&
        (!("notes" in data) || data.notes == null || data.notes.size() <= 500) &&
        data.createdAt is timestamp;
    }

    match /user_profiles/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId && validProfile(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /beans/{docId} {
      allow read, delete: if ownsExistingDoc();
      allow create: if ownsNewDoc() && validBean(request.resource.data);
      allow update: if keepsOwner() && validBean(request.resource.data);
    }

    match /brew_logs/{docId} {
      allow read, delete: if ownsExistingDoc();
      allow create: if ownsNewDoc() && validBrewLog(request.resource.data);
      allow update: if keepsOwner() && validBrewLog(request.resource.data);
    }

    match /maintenance_records/{docId} {
      allow read, delete: if ownsExistingDoc();
      allow create: if ownsNewDoc() && validMaintenanceRecord(request.resource.data);
      allow update: if keepsOwner() && validMaintenanceRecord(request.resource.data);
    }
  }
}
